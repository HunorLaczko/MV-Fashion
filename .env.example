# MV-Fashion Dataset Configuration
# Copy this file to .env and fill in your values

# Path to the MV-Fashion dataset root directory
MV_FASHION_DATASET_ROOT=./mv_fashion_dataset

# HuggingFace authentication token (required for downloading)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here